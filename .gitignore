# Never commit participant-level data. Only frozen, suppressed aggregates leave the analysis machine.
data/raw/*
data/interim/*
!data/raw/.gitkeep
!data/interim/.gitkeep
data/aggregates/*
!data/aggregates/.gitkeep
*.xlsx
*.zip
*.parquet
*.duckdb
*.duckdb.wal
gold_set/
.env
__pycache__/
*.egg-info/
.venv/
.pytest_cache/
.ipynb_checkpoints/
_site/
